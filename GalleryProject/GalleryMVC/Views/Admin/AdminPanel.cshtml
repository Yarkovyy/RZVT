@model IEnumerable<GalleryMVC.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white p-3">
            <h3 class="mb-0">User Management Panel</h3>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Current Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @(user.CurrentRole == "Admin" ? "bg-danger" : "bg-info")">
                                    @user.CurrentRole
                                </span>
                            </td>
                            <td>
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <select name="newRole" class="form-select form-select-sm">
                                        @foreach (var role in user.AllRoles)
                                        {
                                            <option value="@role" selected="@(role == user.CurrentRole)">@role</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-primary btn-sm">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>