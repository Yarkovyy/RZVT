@model GalleryMVC.Models.UploadImageViewModel
@{
    ViewData["Title"] = "Upload";
}

<h2>Upload</h2>

<form asp-action="Upload" method="post">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="ImageName" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="File" class="form-label"></label>
        <input asp-for="Description" type="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Upload</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

