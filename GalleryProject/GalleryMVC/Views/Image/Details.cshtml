@using Gallery.BusinessLogic.Models
@model ImageDetailsViewModel
@using Gallery.DataAccess.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Image Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    &larr; Back to Gallery
                </a>
            </div>

            <div class="card shadow border-0 overflow-hidden">
                <div class="row g-0">

                    <div class="col-md-8 bg-light d-flex align-items-center justify-content-center" style="min-height: 400px;">
                        <img src="@Url.Action("GetImageFile", "Image", new { id = Model.ImgId })"
                             class="img-fluid"
                             alt="@Model.Title"
                             style="max-height: 80vh; width: auto;" />
                    </div>

                    <div class="col-md-4">
                        <div class="card-body p-4">
                            <h2 class="card-title h3 mb-3">@Model.Title</h2>
                            <hr />

                            <div class="mb-4">
                                <label class="text-muted small d-block">Description</label>
                                <p class="card-text">
                                    @(string.IsNullOrWhiteSpace(Model.Description)
                                                                        ? "No description provided for this image."
                                                                        : Model.Description)
                                </p>
                            </div>

                            <div class="mt-auto pt-3 border-top">
                                <p class="text-muted small">
                                    <strong>Uploaded by:</strong> #@Model.UploadedBy
                                </p>
                                <p class="text-muted small">
                                    <strong>Upload date:</strong> #@Model.UploadDate.ToString("MMMM dd, yyyy")
                                </p>

                                @* @if (Context.Session.GetInt32("UserId") != null && Context.Session.GetInt32("UserId") == Model.UserId)
                                { *@
                                @if (User.Identity?.IsAuthenticated == true && UserManager.GetUserId(User) == Model.UserId.ToString())
                                {
                                    <div class="d-grid gap-2 mt-4">


                                        <a asp-action="Edit" asp-route-id="@Model.ImgId" class="btn btn-outline-primary btn-sm">Edit Info</a>
                                        <form asp-action="Delete" asp-controller="Image" asp-route-id="@Model.ImgId" method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this image?');">

                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                Delete Image
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}